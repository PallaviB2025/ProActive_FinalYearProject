{
  "manifest_version": 3,
  "name": "ProActive — Zero-Knowledge Autofill & Vault",
  "version": "1.0.0",
  "description": "Zero-knowledge password manager extension with intelligent autofill, automatic password saving, and local vault security.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ProActive Vault",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://pro-active-final-year-project.vercel.app/*",
    "https://proactive-api-pallavib2025.vercel.app/*",
    "http://127.0.0.1:4000/*",
    "http://localhost:3000/*",
    "https://*/*",
    "http://*/*"
  ]
}
